{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend",
      "cwd": "${workspaceFolder}/apps/back",
      "program": "${workspaceFolder}/apps/back/src/index.ts",
      "runtimeArgs": [
        "--watch",
        "--import",
        "tsx"
      ],
      "sourceMaps": true,
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**",
        "${workspaceFolder}/apps/back/node_modules/**"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/apps/back/.envs/dev.env"
    }
  ]
}