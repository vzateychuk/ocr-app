{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "watch"
      ],
      "args": [
        "${workspaceFolder}/apps/back/src/index.ts"
      ],
      "cwd": "${workspaceFolder}/apps/back",
      "sourceMaps": true,
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**/*.js",
        "${workspaceFolder}/apps/back/node_modules/**/*.js"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/apps/back/.envs/dev.env"
    }
  ]
}
